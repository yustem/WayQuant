WAYQUANT_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
WAYQUANT_CODE_REVISION=
# Frontend build-time settings; empty URL uses the same-origin /api proxy.
VITE_API_BASE_URL=
VITE_CODE_REVISION=
# api (default): local/API execution with genuine browser fallback.
# browser: direct existing Web Worker execution, no API requests.
VITE_EXECUTION_MODE=api
# Use /WayQuant/ for a project site; use / for a root/custom-domain site.
VITE_BASE_PATH=/
